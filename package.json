{
  "name": "agente-qa-contract",
  "version": "0.3.0",
  "description": "Contrato compartido (esquemas Zod) entre las piezas del ecosistema Agente-QA: map.json y ficheros .feature.",
  "type": "module",
  "license": "MIT",
  "author": "Nicolascarames",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "import": "./dist/project.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "overrides": {
    "rolldown": "1.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.10"
  }
}
